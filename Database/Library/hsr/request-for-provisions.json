              {
                "type": "text",
                "text": "Required Supplies: Bellerain Petroleum Jelly"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Remarks: 1 bottle, the weather here is too dry, I can't stand it."
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Application Comment: Approved. Dude looks like a bruiser, but he's pretty conscious about his looks."
              }
