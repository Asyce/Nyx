{
  "name": "nyxarium-scraper",
  "private": true,
  "type": "module",
  "scripts": {
    "banners": "node ./banners/scrape.cjs",
    "banners:test": "node --test banners/tests/",
    "codes": "node ./codes/scrape.cjs",
    "codes:livestreams": "node ./codes/detect-livestream-windows.cjs",
    "codes:watch": "node ./codes/scrape.cjs --active-only --change-gated",
    "codes:watch:deep": "node ./codes/scrape.cjs --active-only --deep --change-gated",
    "codes:diff": "node ./codes/semantic-diff.cjs",
    "codes:test": "node --test codes/tests/",
    "test": "node --test codes/tests/ banners/tests/",
    "validate": "node ./validate-data.cjs",
    "validate:strict": "node ./validate-data.cjs --strict-freshness",
    "endfield:wiki": "node ./endfield-wiki/scrape.mjs",
    "gachabase:beta": "node ./gachabase-beta/scrape.mjs",
    "nanoka": "node ./nanoka/scrape.mjs",
    "nanoka:gi": "node ./nanoka/scrape.mjs --game gi",
    "nanoka:hsr": "node ./nanoka/scrape.mjs --game hsr",
    "nanoka:ww": "node ./nanoka/scrape.mjs --game ww",
    "nanoka:zzz": "node ./nanoka/scrape.mjs --game zzz",
    "prydwen": "node ./prydwen/scrape.mjs",
    "prydwen:endfield": "node ./prydwen/scrape.mjs --game endfield",
    "prydwen:hsr": "node ./prydwen/scrape.mjs --game hsr",
    "prydwen:wuwa": "node ./prydwen/scrape.mjs --game ww",
    "prydwen:ww": "node ./prydwen/scrape.mjs --game ww",
    "prydwen:zzz": "node ./prydwen/scrape.mjs --game zzz",
    "wiki:titles": "node ./wiki-titles/scrape.mjs",
    "wiki:titles:gi": "node ./wiki-titles/scrape.mjs --game gi",
    "wiki:titles:hsr": "node ./wiki-titles/scrape.mjs --game hsr",
    "wiki:titles:wuwa": "node ./wiki-titles/scrape.mjs --game wuwa",
    "wiki:titles:ww": "node ./wiki-titles/scrape.mjs --game ww",
    "wiki:titles:zzz": "node ./wiki-titles/scrape.mjs --game zzz"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  }
}
