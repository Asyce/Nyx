{
  "schemaVersion": 1,
  "game": "hsr",
  "id": "a-note-from-castorice",
  "name": "A Note from Castorice",
  "sourceUrl": "https://honkai-star-rail.fandom.com/wiki/A_Note_from_Castorice",
  "scrapedAt": "2026-07-11T05:51:38.089Z",
  "volumes": [
    {
      "id": "1",
      "label": "Text",
      "document": {
        "version": 1,
        "blocks": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Dear they (Trailblazer),"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "When the cold wind brings the first drifting snow,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "we step into the muddy wilderness."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Gathering the dying petals,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "we let their withered glory rest in the traveler's flower crown."
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "From footprints traveling back and forth, paths are woven."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Never had I imagined that one day I would wear a flower crown."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Leave this snowy realm, cross that boundary dawn and dusk, between life and death."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Journey to a world still warm with life,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "and smile while embracing others."
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Before your departure, take this flower crown with you."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "It has accompanied me through endless paths, across the shores of darkness."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Chase the end of the west wind, and witness the world's rebirth."
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "May those flowers, like dancing butterflies,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "rest upon your brow when you're weary."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "May life's gentle warmth always stay by your side."
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Castorice"
              }
            ]
          }
        ]
      }
    }
  ]
}
