          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Thirty-year anniversary commemorative album for"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "Beneath the White Cloak"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "A commemorative album showcasing thirty years of casts and stage sets for all the iterations of"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "Beneath the White Cloak"
                  }
                ]
              },
              {
                "type": "text",
                "text": ".\""
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "A special release for audience members who love"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
