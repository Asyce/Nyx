{
  "schemaVersion": 1,
  "game": "hsr",
  "id": "floating-grease-chronicles-chapter-of-the-monkey",
  "name": "Floating Grease Chronicles: Chapter of the Monkey",
  "sourceUrl": "https://honkai-star-rail.fandom.com/wiki/Floating_Grease_Chronicles:_Chapter_of_the_Monkey",
  "scrapedAt": "2026-08-07T08:04:06.206Z",
  "volumes": [
    {
      "id": "1",
      "volumeKey": "i",
      "label": "I",
      "document": {
        "version": 1,
        "blocks": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Monkeys in winter,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "feast on the seals' raw flesh,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "and soak in a bathtub for sulfur baths."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Oil seeping from the petrified whale remains,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "paints the moonless pitch-black sky."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "That beloved asphalt,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "can build waterproof houses."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Monkeys in winter chorus atop power poles,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "singing the trendiest beats from cosmic radio,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "mocking those rustic frogs."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "They say they'll soon grow wings,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "soaring freer than falcons in the azure sky."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Then the frogs will shed only tears of regret,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "becoming their cheapest joke seasoning."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "So the monkeys laughed until they cried,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "yet these tears brought no moon."
              }
            ],
            "id": "p-4582a4d37a9f158f"
          }
        ]
      }
    },
    {
      "id": "2",
      "volumeKey": "xi",
      "label": "XI",
      "document": {
        "version": 1,
        "blocks": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Since who knows how many years ago,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The monkeys no longer had a Monkey King."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "They learned to read the wisdom of the moon,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "And boil asphalt into syrup."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Asphalt is the shadow of utmost darkness,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Both a curse and a wonder of finance."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "A monkey laughing till tears fall,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Has learned the trick of pulling something out of thin air."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "I grant you one minute as a god,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "While shadow and moon whisper in unison."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The animals rejoice with glee,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "But none expect the end draws near.Oh no,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "An old monkey stops in its tracks, crying out in alarm."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "On the moon has appeared a crack,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "That corresponds with the ancient prophecy."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The end draws near,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "And the moon shatters."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The trees remain silent,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "But the monkeys can no longer climb."
              }
            ],
            "id": "p-4fc596367b3ed87e"
          }
        ]
      }
    },
    {
      "id": "3",
      "volumeKey": "part-xxiii",
      "label": "Part XXIII",
      "document": {
        "version": 1,
        "blocks": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "In pursuit of the truth"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Monkeys began to fabricate"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "They revoked the power to falsify"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "And enshrined the narratives of their hearts as the highest truth"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The blind were sought after"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The virtuous abandoned flight"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The world was no longer predicted"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Truthful lies, ever more fond of explanation"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "And narrative broke free from art"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The monkeys yearned to embrace freedom"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Refusing the grand deception"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Refusing the simulated, refusing the borrowed"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Refusing a world so \"false\" as this"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "They received the truth they needed"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "And the land began to kill"
              }
            ],
            "id": "p-fc730823ce80dbb7"
          }
        ]
      }
    }
  ]
}
