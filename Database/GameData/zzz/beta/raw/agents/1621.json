    "special": {
      "description": [
        {
          "name": "Special Attack: Wind Gather",
          "desc": "Press <IconMap:Icon_Special> to activate:\nStrike forward, dealing <color=#A6C5FD>Wind DMG</color>.",
          "potential": []
        },
        {
          "name": "EX Special Attack: Rising Wind",
          "desc": "With enough Energy, press <IconMap:Icon_SpecialReady> to activate:\nFires a wind cannon forward, dealing <color=#A6C5FD>Wind DMG</color>.\nThe wind cannon explodes upon hitting the ground, dealing <color=#A6C5FD>Wind DMG</color>. When fired, it consumes all <color=#ffffff>[Wind Energy]</color>, causing additional explosions on the ground. Each 1 point of <color=#ffffff>[Wind Energy]</color> causes 1 explosion, up to a maximum of 3 explosions. Each explosion generates 1 <color=#ffffff>[Eye of the Storm]</color> at its location.\nUp to 3 <color=#ffffff>[Eye of the Storm]</color> can exist on the field simultaneously. <color=#ffffff>[Eye of the Storm]</color> lasts 30 seconds.\nWhen <color=#ffffff>[Wind Energy]</color> is available, automatically chains into <color=#ffffff>[EX Special Attack: Wind Cannon]</color>.",
          "potential": []
        },
        {
          "name": "EX Special Attack: Riding the Wind",
          "desc": "With enough energy, hold <IconMap:Icon_SpecialReady> to activate:\nRoxy generates a tornado. Keep holding <IconMap:Icon_SpecialReady> and drag the {LAYOUT_CONSOLECONTROLLER#stick}{LAYOUT_FALLBACK#joystick} to control the tornado's movement direction. During this time, Energy is continuously consumed and <color=#A6C5FD>Wind DMG</color> is dealt to enemies in its path.\nStops when Energy is depleted, or when <IconMap:Icon_SpecialReady> is released without dragging the {LAYOUT_CONSOLECONTROLLER#stick}{LAYOUT_FALLBACK#joystick}.\nAfter stopping, fires a wind cannon with the same effect as <color=#ffffff>[EX Special Attack: Rising Wind]</color>.\nWhen <color=#ffffff>[Wind Energy]</color> exists, automatically chains into <color=#ffffff>[EX Special Attack: Wind Cannon]</color>; when <color=#ffffff>[Wind Energy]</color> does not exist, automatically chains into <color=#ffffff>[Basic Attack: Meteor Hammer]</color>.",
          "potential": []
        },
        {
          "name": "EX Special Attack: Wind Cannon",
          "desc": "When <color=#ffffff>[Wind Energy]</color> exists at the end of <color=#ffffff>[EX Special Attack: Rising Wind]</color> or <color=#ffffff>[EX Special Attack: Riding Wind]</color>, automatically activates:\nFires a wind cannon forward, dealing <color=#A6C5FD>Wind DMG</color>.\nWhen the wind cannon hits the ground, it explodes, dealing <color=#A6C5FD>Wind DMG</color>; all <color=#ffffff>[Wind Energy]</color> is consumed when firing the wind cannon, causing additional explosions on the ground. Each 1 point of <color=#ffffff>[Wind Energy]</color> causes 1 explosion, up to a maximum of 3 explosions. Each explosion generates 1 <color=#ffffff>[Eye of the Storm]</color> at the point of impact.\nUp to 3 <color=#ffffff>[Eye of the Storm]</color> can exist on the field at the same time. <color=#ffffff>[Eye of the Storm]</color> lasts for 30s.",
          "potential": []
        },
