                  }
                ]
              },
              {
                "type": "text",
                "text": "Misprinted \"Cosmicon Collective\" Card Set"
              },
              {
                "type": "br"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Lot Description:"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Includes four one-of-a-kind cards: \"Gastorice,\" \"Ricecasto,\" \"Castorfly,\" and \"Caztorise.\""
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Due to a printing plate misalignment, the card names and artwork are severely mismatched. Certified by professional appraisal institutions as a \"one-of-a-kind cosmic item.\" Encapsulated in a protective anti-counterfeit case with minor surface scratches on the case."
              },
              {
                "type": "br"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Starting Bid:"
                  }
                ]
              },
              {
                "type": "text",
                "text": "10,000,000"
              },
              {
                "type": "br"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Estimated Value:"
                  }
                ]
              },
              {
                "type": "text",
                "text": "20,000,000 – 40,000,000"
              }
            ],
            "id": "p-724a83015cbf295a"
          },
          {
            "type": "paragraph",
