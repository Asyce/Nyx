{
  "schemaVersion": 1,
  "game": "hsr",
  "id": "a-note-from-tribbie",
  "name": "A Note from Tribbie",
  "sourceUrl": "https://honkai-star-rail.fandom.com/wiki/A_Note_from_Tribbie",
  "scrapedAt": "2026-07-12T09:01:05.289Z",
  "volumes": [
    {
      "id": "1",
      "label": "Text",
      "document": {
        "version": 1,
        "blocks": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Dear Little Gray:"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Originally, Tribbie was supposed to write this letter."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "But Trianne also has a lot to say to you!"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "In the end,"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "we"
                  }
                ]
              },
              {
                "type": "text",
                "text": "decided to write one line each..."
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "We"
                  }
                ]
              },
              {
                "type": "text",
                "text": "once delivered prophecies to city-states scattered far and wide."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "We"
                  }
                ]
              },
              {
                "type": "text",
                "text": "once opened gateways for the Chrysos Heirs warring across the lands!"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "We"
                  }
                ]
              },
              {
                "type": "text",
                "text": "once listened to prophecies in the Temple of Janus..."
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "In the end, Little Gray fulfilled"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "our"
                  }
                ]
              },
              {
                "type": "text",
                "text": "Flame-Chase wish."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Little Gray drove away the villains emerging from the black tide!"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "It was Little Gray who saved everyone in Amphoreus..."
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "So, please accept this Tribbie plushie,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Trianne stuffed the cotton inside, she worked so hard!"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "And Trinnon sewed it together, stitch by stitch..."
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "The three of"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "us"
                  }
                ]
              },
              {
                "type": "text",
                "text": "have written enough already. Next, here's a wish from a thousand of"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "us"
                  }
                ]
              },
              {
                "type": "text",
                "text": ":"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "May you ride the west wind to where the flowers bloom. There is no need to be saddened by partings."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "We'll see you tomorrow!"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Tribios"
              }
            ]
          }
        ]
      }
    }
  ]
}
