            "children": [
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "The romantic drama"
                  }
                ]
              },
              {
                "type": "text",
                "text": "Stardust Rose"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "starring Julie and Iain."
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "On show at the Golden Theater on March 7."
                  }
                ]
              },
