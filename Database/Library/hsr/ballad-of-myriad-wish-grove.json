  "name": "Ballad of Myriad Wish Grove",
  "sourceUrl": "https://honkai-star-rail.fandom.com/wiki/Ballad_of_Myriad_Wish_Grove",
  "scrapedAt": "2026-07-23T09:23:41.138Z",
  "volumes": [
    {
      "id": "1",
      "volumeKey": "text",
      "label": "Text",
      "document": {
        "version": 1,
        "blocks": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Arriving at the golden solitude,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Standing upright at the horizon's edge,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Is the silhouette of your sundial."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Fool of fools,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Actor of actors,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Paradox of paradoxes,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Shadow of shadows."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Seeking no sunlight,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Questioning no causality."
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Only from your own roots,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Sips the eternal thirst."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The world's end,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The starting line of eternal return."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Myriad Wish Grove,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "We praise you, the immortal Great Tree."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Every branch and leaf of yours experiences"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The first and final decay,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The final and first incineration."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Noon is an illusion of calculus,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Midnight is the anchor of renormalization."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "You are our hologram,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Yet refuse to be our simulation:"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Only lifting the letters that compose us,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "One by one into the starry sky."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "We are suspended by you,"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "We are revived by you."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Everything ends and begins simultaneously"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "In the eternal Myriad Wish Grove."
              }
            ],
            "id": "p-463568450796b1ca"
          }
        ]
      }
    }
  ]
}
