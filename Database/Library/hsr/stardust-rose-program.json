        "blocks": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Opens March 7th"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": []
              }
            ],
            "id": "p-00e313a5b8a433fe"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "A Golden Theater Drama Department's authentic production three years in the making"
              }
            ],
            "id": "p-4efecb3a1e576459"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "A failed IPC sales manager was fired from his head office and came to a small border town."
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "He Accidentally discovers a long-extinct rose and falls in love with a botanist who came looking for it."
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "When he realizes that this precious flower he stumbled upon could be his ticket back to the top of the IPC, what will he choose to do?"
                  }
                ]
              }
            ],
            "id": "p-ef37c5434b4da181"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "and"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Co-Directors"
              }
            ],
            "id": "p-61c12756b7713dac"
          },
          {
            "type": "paragraph",
            "children": [],
            "id": "p-882a20e6379eb83a"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Writing: Amy"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
