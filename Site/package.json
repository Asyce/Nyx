{
  "name": "nyxarium-site",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:data": "node ./tools/generate-site-data.mjs",
    "generate:weapons": "node ./tools/gen-weapons-meta.mjs",
    "scrape:gcg": "node ./tools/scrape-gamedata-gcg.mjs",
    "scrape:furniture": "node ./tools/scrape-gamedata-furniture.mjs",
    "localize:icons": "node ./tools/localize-gamedata-icons.mjs",
    "scrape:gcg:ambr": "node ./tools/scrape-ambr-gcg.mjs",
    "scrape:character-meta": "node ./tools/scrape-character-fandom-metadata.mjs",
    "scrape:gi-birthdays": "node ./tools/scrape-genshin-birthday-art.mjs",
    "scrape:gi-namecards": "node ./tools/scrape-genshin-namecards.mjs",
    "scrape:ae-skills": "node ./tools/scrape-endfield-skill-icons.mjs",
    "scrape:gi-signatures": "node ./tools/scrape-genshin-signature-weapons.mjs",
    "scrape:hsr-holidays": "node ./tools/scrape-hsr-holiday-art.mjs",
    "scrape:hsr-signatures": "node ./tools/scrape-hsr-signature-lightcones.mjs",
    "scrape:side-data": "node ./tools/run-side-data-sync.mjs",
    "build": "npm run generate:data && npm run generate:weapons && node ./tools/build-site.mjs",
    "build:deploy": "npm run build && node ./tools/build-deploy.mjs && node ./tools/inject-seo.mjs",
    "smoke:deploy": "node ./tools/smoke-deploy.mjs",
    "test:favourites": "node ./tools/test-pinned-favourites.mjs",
    "test:runtime-publisher": "node --test ./tools/tests/publish-runtime-data.test.mjs",
    "test:custom-timers": "node --test ./tools/tests/custom-timer-storage.test.mjs",
    "test:timeline": "node --test ./tools/tests/timeline-data.test.mjs",
    "test:calendar": "node --test ./tools/tests/birthday-calendar.test.mjs",
    "test:characters": "node --test ./tools/tests/characters-nyx.test.mjs",
    "test:database-ui": "node --test ./tools/tests/database-ui.test.mjs",
    "test:library": "node --test ./tools/tests/library-ui.test.mjs",
    "test:library-annotations": "node --test ./tools/tests/library-annotations.test.mjs",
    "test:achievements": "node --test ./tools/tests/achievement-import-storage.test.mjs ./tools/tests/achievement-view-model.test.mjs",
    "test:achievement-extractor": "node --test ./tools/tests/achievement-extractor-script.test.mjs",
    "test:achievement-hoyolab": "node --test ./tools/tests/achievement-hoyolab-exporter.test.mjs",
    "serve": "python -m http.server 5173 --bind 127.0.0.1 --directory .."
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=20"
  }
}
