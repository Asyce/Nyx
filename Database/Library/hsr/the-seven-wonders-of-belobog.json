                "text": "<!--"
              }
            ]
          },
          {
            "type": "list",
            "ordered": true,
            "items": [
              {
                "children": [
                  {
                    "type": "text",
                    "text": "There is a place in the city where if you continue walking forward, you will end up in the air."
                  }
                ]
              },
              {
                "children": [
                  {
                    "type": "text",
                    "text": "If you repeatedly rock back and forth at the corner of the street, the ground will open up and swallow you into the abyss."
                  }
                ]
              },
              {
                "children": [
                  {
                    "type": "text",
                    "text": "At a specific point in time, the people that pass by you will suddenly open their arms and make a T-pose."
                  }
                ]
              },
              {
                "children": [
                  {
                    "type": "text",
                    "text": "If you suddenly turn around at a crowded place, the walls will become white."
                  }
                ]
              },
              {
                "children": [
                  {
                    "type": "text",
                    "text": "If you utter a certain mysterious phrase, the person you're conversing with will turn into a monster."
                  }
                ]
              },
              {
                "children": [
                  {
                    "type": "text",
                    "text": "The heater and trash can on the side of the street become square boxes when it snows."
                  }
                ]
              },
              {
                "children": [
                  {
                    "type": "text",
                    "text": "When you're in a place with no one else around, music of an unknown origin could be heard."
                  }
                ]
              },
              {
                "children": [
                  {
                    "type": "text",
                    "text": "If you are reading this, all the miraculous things above will happen to you."
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
