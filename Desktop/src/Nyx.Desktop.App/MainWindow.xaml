<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nyx_Desktop_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nyx - Pengo">
    <Grid>
        <Frame x:Name="RootFrame" />

        <Grid
            x:Name="AppTitleBar"
            Height="32"
            VerticalAlignment="Top"
            AutomationProperties.Name="Window drag region"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftTitleBarInset" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightTitleBarInset" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" Background="Transparent">
                <Button
                    x:Name="SettingsButton"
                    Height="32"
                    MinHeight="32"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Open settings for the selected game"
                    Click="SettingsButton_Click"
                    Style="{StaticResource NyxTitleBarActionStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE713;" />
                        <TextBlock VerticalAlignment="Center" Text="Settings" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
