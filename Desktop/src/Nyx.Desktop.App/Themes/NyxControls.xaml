    <Style x:Key="NyxLaunchButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="270" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource LaunchActionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LaunchActionBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource LaunchActionForegroundBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource LaunchActionBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="LaunchSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Border
                                Margin="4"
                                BorderBrush="{ThemeResource DeckBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5" />
                            <Border
                                Margin="8"
                                BorderBrush="{ThemeResource IrisBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Opacity="0.58" />
                            <Rectangle
                                Height="1"
                                Margin="22,0"
                                VerticalAlignment="Top"
                                Fill="{ThemeResource IrisBrush}"
                                Opacity="0.7" />
                            <Rectangle
                                Height="2"
                                Margin="22,0"
                                VerticalAlignment="Bottom"
                                Fill="{ThemeResource IrisBrush}"
                                Opacity="0.9" />
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LaunchSurface.Opacity" Value="0.9" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LaunchSurface.Opacity" Value="0.76" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="LaunchSurface.Opacity" Value="0.48" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
