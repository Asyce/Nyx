          {
            "type": "paragraph",
            "children": [],
            "id": "p-882a20e6379eb83a"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Grand Prize"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "\"Work Exemption Certificate\": Congratulations! As of today, you have earned yourself a lifetime of unpaid leave!"
              }
            ],
            "id": "p-193c6e7b16e90b65"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "First Prize"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "\"Ascension Voucher\": Upon use, you will be granted a one-on-one meeting with Madam Pearl. The conversation is limited to 30 minutes, so make the most of this opportunity to move up the social ladder."
              }
            ],
            "id": "p-2d6cf18398cc1bc9"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Second Prize"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "\"Empty Layoff List\": This list can be applied to any employee below the P30 rank, forcing them to pack their bags and leave within three days. This is a single-use item. Please select your target with caution."
              }
            ],
            "id": "p-c6023af82261fb3f"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Third Prize"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "\"Efficiency Boost Bundle\": Includes a \"Forced Wake-up Alarm,\" an \"EEG Monitor,\" and an \"Electric Shock Smart Chair\" to assist users in maximizing their productivity."
              }
            ],
            "id": "p-3abe50c7f5f051b3"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Fourth Prize"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "\"Collaboration Artbook\": A limited-edition artbook produced in collaboration with the"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "Daybreak Squadron"
                  }
                ]
              },
              {
                "type": "text",
                "text": "VFX film. While in high demand on the market, the item contains special encoding and resale is strictly prohibited."
              }
            ],
            "id": "p-6eb32e2c225b1528"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Fifth Prize"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "\"Mechatron Capsule Set\": A classic collection of mechatron capsule giftboxes produced by Pearluxe, featuring the full lineup of models from the"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "Transrebars"
                  }
                ]
              },
              {
                "type": "text",
                "text": "series."
              }
            ],
            "id": "p-4c4b8cb7a65b6333"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Participation Prize"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "\"Thank You Box\": Contains a \"Deluxe Edition Employee Handbook,\" 10 cafeteria vouchers, and 3 paid sick leave application forms."
              }
            ],
            "id": "p-a33ea33a3eb1499c"
          }
        ]
      }
    }
  ]
}
