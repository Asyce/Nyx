        "blocks": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Case Study 1"
              }
            ],
            "id": "p-f3a2af734c4540f7"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Patient information:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Outworlder, human (capillus subspecies) of the genus Homo, 23-year-old female."
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Outworlder, human (capillus subspecies) of the genus Homo, 23-year-old female."
              }
            ],
            "id": "p-4dde8cd4414deccb"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Chief complaint:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Two patients complained of using neural implants to connect their senses to each other for a long time since birth. Severe identity confusion has now developed, resulting in the patients' inability to correctly identify themselves."
              }
            ],
            "id": "p-537eb14f945edc81"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Treatment plan:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Undergo surgical removal of the neural implants, and take three doses of Spirit-Soothe Powder."
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "Note: The Spirit-Soothe Powder medicine is extremely yin-natured and cooling, so it should not be taken in excess."
                  }
                ]
              }
            ],
            "id": "p-f903edc73e4fe2cd"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Follow-up:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "The treatment's effect is good. Both patients have returned to normal conditions."
              }
            ],
            "id": "p-6a77d831b8476b48"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Case Study 2"
              }
            ],
            "id": "p-01fa10f20e5ca82a"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Patient information:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Outworlder, Homo sapiens (Σ subspecies) of the genus Homo, 47-year-old male."
              }
            ],
            "id": "p-5a4123778014c885"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Chief complaint:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Spacecraft accident resulted in irreversible damage to 80% of the patient's brain tissue."
              }
            ],
            "id": "p-d139fe9db7996120"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Treatment plan:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Injection of neural stem cells and electrical stimulation therapy to activate the compensatory mechanisms of the remaining brain tissue. Use autologous tissue culture to reconstruct the missing cranial bone. Postoperative intravenous injection of Dragon King Nirvana Broth to prevent infection and promote recovery."
              }
            ],
            "id": "p-6b46cf29c15937ad"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Follow-up:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Treatment is working well. The patient is now able to continue completing his literary work."
              }
            ],
            "id": "p-71e018bd71aaa18b"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Case Study 3"
              }
            ],
            "id": "p-86787c1608794af7"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Patient information:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Vidyadhara, 307-year-old female."
              }
            ],
            "id": "p-115f58c327d2cd61"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Chief complaint:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Patient entered a comatose state for 100 to 150 years after hatching rebirth. The diagnosis is Everdream Syndrome, which is caused by inefficient energy conversion during the hatching rebirth period."
              }
            ],
            "id": "p-00c754e65d51d72e"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Treatment plan:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Patient requires lifelong intake of qi-supplementing medication."
              }
            ],
            "id": "p-de21dd05b09bcd12"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Follow-up:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Unavailable. Need to wait until the next hatching rebirth of the patient to confirm."
              }
            ],
            "id": "p-7aedabeaf4fa19d2"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Case Study 4"
              }
            ],
            "id": "p-28c53bdc3705f79b"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Patient information:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Outworlder, Homo sapiens (sapiens subspecies) of the genus Homo, 21-year-old male."
              }
            ],
            "id": "p-8fc5deb55867c40f"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Chief complaint:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Patient complained of \"Cyber-Obscenity Syndrome,\" which was diagnosed outside Xianzhou but could not be treated locally. The patient does not like to engage in conflict with people in daily life, but cannot suppress his strong impulse to verbally abuse and provoke others, and to stir the pot in cyberspace."
              }
            ],
            "id": "p-48924d5a25f93c5f"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Treatment plan:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Undergo psychological intervention, with the main goal of guiding the patient to find a job."
              }
            ],
            "id": "p-43dcc0effcc03e0c"
          },
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "text": "Follow-up:"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Treatment has been effective. The patient is now self-reliant."
              }
            ],
            "id": "p-93cee905436556e2"
          }
        ]
      }
    }
  ]
}
