              {
                "type": "text",
                "text": "I stopped by Feiyun Slope to view the merchants' wares:"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "precious stones of every kind — from expensive to astronomical."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "But why waste Mora here on rocks, and have none left to spare?"
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "I'd rather spend at Yujing Terrace on all things gastronomical."
              }
            ],
