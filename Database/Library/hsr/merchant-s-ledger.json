              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Purchase Price: 800 Balance Coins"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Sale Price: 1,200 Balance Coins"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Units Sold: 50"
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "*No wonder the workshop staff placed some orders with me. I didn't know how heavy one bag would be! My back almost gave out just carrying it around!*"
                  }
                ]
              }
            ],
            "id": "p-ee79402081064212"
          },
          {
            "type": "paragraph",
            "children": [
