{
  "schemaVersion": 1,
  "game": "hsr",
  "id": "definitely-not-floating-grease-chronicles",
  "name": "Definitely Not Floating Grease Chronicles",
  "sortId": 166910,
  "sourceUrl": "https://honkai-star-rail.fandom.com/wiki/Definitely_Not_Floating_Grease_Chronicles",
  "scrapedAt": "2026-09-06T11:27:03.023Z",
  "volumes": [
    {
      "id": "1",
      "volumeKey": "text",
      "label": "Text",
      "document": {
        "version": 1,
        "blocks": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "If you are the greatest treasure hunter in the world,"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "then congratulations,"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "you have obtained the most precious fortune in this universe:"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "an alchemy recipe."
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "Commit it to your memory, and never let it go."
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Ingredients:"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Two ripe red tomatoes,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "three fresh eggs,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "15ml of refined vegetable oil,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "3g of salt,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "2g of white sugar,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "and one green onion."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Synthesis Process:"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Core the tomatoes and cut lengthwise,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "slice into crescent-shaped wedges,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "crack the eggs into a bowl,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "beat the eggs until smooth,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "finely chop the green onion and set aside,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "place the pan over high heat,"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "coat the pan evenly with oil;"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Once the oil is hot, pour in the egg mixture, gently swirl and spread flat;"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Just before the eggs fully solidify, turn off the heat;"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Transfer the naturally solidified egg pieces to a plate and set aside;"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Return the pan to high heat, add the tomato wedges and stir-fry;"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Sprinkle in the sugar and continue stir-frying"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "until the tomatoes soften and release a large amount of juice;"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Return the egg pieces to the pan, add salt, reduce to low heat;"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Gently toss everything together until the sauce evenly coats the egg pieces;"
              },
              {
                "type": "br"
              },
              {
                "type": "text",
                "text": "Once the sauce thickens slightly, turn off the heat, plate, and garnish with green onion."
              },
              {
                "type": "br"
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "Yes, this is nothing more than a recipe for Tomato and Egg Stir-Fry, the most ordinary of home-cooked dishes."
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "Perhaps you were expecting something else,"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "but, if you'll humor an old ramble from Arita..."
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "No myths or legends can hold a candle to a simple recipe of a home-cooked dish."
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "O greatest of treasure hunters!"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "Do not let the Elation of others"
                  }
                ]
              },
              {
                "type": "br"
              },
              {
                "type": "em",
                "children": [
                  {
                    "type": "text",
                    "text": "lead your heart astray!"
                  }
                ]
              }
            ],
            "id": "p-480e557ba06554e0"
          }
        ]
      }
    }
  ]
}
