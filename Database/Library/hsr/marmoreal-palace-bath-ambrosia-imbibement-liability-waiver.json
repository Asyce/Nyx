  "sourceUrl": "https://honkai-star-rail.fandom.com/wiki/Marmoreal_Palace_%E2%80%94_Bath_Ambrosia_Imbibement_Liability_Waiver",
  "scrapedAt": "2026-07-27T10:38:21.982Z",
  "volumes": [
    {
      "id": "1",
